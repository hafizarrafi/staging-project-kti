<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend Contact Form: tambah field Kategori Diskon di tab Sales & Purchase -->
    <record id="view_partner_form_discount_category" model="ir.ui.view">
        <field name="name">res.partner.form.discount.category</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_suspend_partner" string="Suspend Customer" type="object" 
                            invisible="is_suspended or not id" class="oe_highlight" groups="sales_team.group_sale_manager"/>
                    <button name="action_activate_partner" string="Activate Customer" type="object" 
                            invisible="not is_suspended" class="oe_highlight" groups="sales_team.group_sale_manager"/>
                </header>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_sale_order" type="object" class="oe_stat_button" icon="fa-usd" invisible="not is_company">
                    <div class="o_stat_info">
                        <span class="o_stat_text">History</span>
                    </div>
                </button>
            </xpath>

            <xpath expr="//page[@name='sales_purchases']//group[1]" position="after">
                <group string="Fastindo Classification">
                    <group>
                        <field name="discount_category_id" options="{'no_create': True}"/>
                        <field name="discount_percentage"/>
                        <field name="risk_category_id" options="{'no_create_edit': False}"/>
                        <!-- <field name="receivable_category_id" options="{'no_create_edit': False}"/> -->
                        <field name="segment_id" options="{'no_create_edit': False}"/>
                    </group>
                    <group>
                        <field name="default_expedition_id" options="{'no_create': True}"/>
                        <field name="overpayment_balance" widget="monetary"/>
                        <field name="is_suspended" readonly="1" widget="boolean_toggle"/>
                    </group>
                </group>
            </xpath>
            
            <xpath expr="//notebook" position="inside">
                <page string="Suspension History" name="suspension_history" invisible="not suspension_log_ids">
                    <field name="suspension_log_ids" readonly="1">
                        <list>
                            <field name="create_date" string="Date"/>
                            <field name="state"/>
                            <field name="reason"/>
                            <field name="user_id"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="partner_suspension_log_view_form" model="ir.ui.view">
        <field name="name">partner.suspension.log.view.form</field>
        <field name="model">partner.suspension.log</field>
        <field name="arch" type="xml">
            <form string="Suspend Customer">
                <group>
                    <field name="partner_id" readonly="1"/>
                    <field name="state" invisible="1"/>
                    <field name="reason" required="1" placeholder="Enter reason for suspension..."/>
                </group>
                <footer>
                    <button name="action_confirm_suspension" string="Confirm Suspend" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <!-- Actions for Configuration -->
    <record id="action_partner_risk_category" model="ir.actions.act_window">
        <field name="name">Risk Categories</field>
        <field name="res_model">partner.risk.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a new partner risk category</p>
        </field>
    </record>

    <!-- 
    <record id="action_partner_receivable_category" model="ir.actions.act_window">
        <field name="name">Receivable Categories</field>
        <field name="res_model">partner.receivable.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a new partner receivable category</p>
        </field>
    </record>
    -->

    <record id="action_partner_segment" model="ir.actions.act_window">
        <field name="name">Partner Segments</field>
        <field name="res_model">partner.segment</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a new partner segment</p>
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_partner_classification_config"
              name="Category Configuration"
              parent="contacts.menu_contacts"
              sequence="50"/>

    <menuitem id="menu_partner_discount_category"
              name="Kategori Diskon"
              parent="menu_partner_classification_config"
              action="action_discount_category"
              sequence="5"/>

    <menuitem id="menu_partner_risk_category"
              name="Risk Categories"
              parent="menu_partner_classification_config"
              action="action_partner_risk_category"
              sequence="10"/>

    <!-- 
    <menuitem id="menu_partner_receivable_category"
              name="Receivable Categories"
              parent="menu_partner_classification_config"
              action="action_partner_receivable_category"
              sequence="20"/>
    -->

    <menuitem id="menu_partner_segment"
              name="Partner Segments"
              parent="menu_partner_classification_config"
              action="action_partner_segment"
              sequence="30"/>

</odoo>
