<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_pic_penerima" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.pic.penerima</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <!-- Add PIC Penerima field in the right group after origin -->
            <xpath expr="//field[@name='origin']" position="after">
                <field name="pic_penerima" 
                       readonly="state in ['cancel', 'done']"
                       required="picking_type_code == 'outgoing' and state == 'assigned'"
                       invisible="picking_type_code != 'outgoing'"/>
            </xpath>
        </field>
    </record>
</odoo>
