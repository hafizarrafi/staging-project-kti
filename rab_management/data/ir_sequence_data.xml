<odoo>
  <!-- untuk penomoran rab -->
  <data noupdate="1">
    <record id="seq_rab_management" model="ir.sequence">
      <field name="name">RAB Management</field>
      <field name="code">rab.management</field>
      <field name="prefix">RAB/%(year)s/</field>
      <field name="padding">4</field>
      <field name="company_id" eval="False"/>
    </record>

    <record id="seq_project_material_issue" model="ir.sequence">
      <field name="name">Material Issue Planning</field>
      <field name="code">project.material.issue</field>
      <field name="prefix">ISSUE/%(year)s/</field>
      <field name="padding">4</field>
      <field name="company_id" eval="False"/>
    </record>

    <record id="seq_project_material_consumption" model="ir.sequence">
      <field name="name">Material Consumption tracking</field>
      <field name="code">project.material.consumption</field>
      <field name="prefix">CONS/%(year)s/</field>
      <field name="padding">4</field>
      <field name="company_id" eval="False"/>
    </record>
  </data>
</odoo>