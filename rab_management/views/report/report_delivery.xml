<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Override delivery slip -->
  <template id="report_delivery_document_auditor_proof" inherit_id="stock.report_delivery_document">
    <xpath expr="." position="replace">
      <!-- <t t-name="stock.report_delivery_document_auditor_proof"> -->
        <t t-call="web.html_container">
          <t t-call="web.external_layout">
            <style>
            table.header-info,
            table.header-info tr,
            table.header-info td {
                background: #ffffff !important;
                background-color: #ffffff !important;
                border: none !important;
            }</style>
            <!-- ================= CONTEXT ================= -->
            <t t-set="o" t-value="o.with_context(lang=o._get_report_lang())"/>
            <t t-set="partner" t-value="o.partner_id or (o.move_ids and o.move_ids[0].partner_id) or False"/>
            <t t-set="is_incoming" t-value="o.picking_type_id.code == 'incoming'"/>
            <t t-set="is_outgoing" t-value="o.picking_type_id.code == 'outgoing'"/>
            <t t-set="is_internal" t-value="o.picking_type_id.code == 'internal'"/>
            <t t-set="fmt" t-value="lambda v: int(v) if isinstance(v,(int,float)) and v==int(v) else v"/>
            <!-- ================= HEADER ================= -->
            <!-- ================= HEADER ================= -->
            <table class="header-info" style="width:100%; font-size:12.5px; line-height:1.4; border-collapse:collapse; background-color:transparent; border:none;">
              <tr>
                <!-- LEFT -->
                <td style="width:65%; vertical-align:top; padding-right:12px; background-color:transparent;">
                  <!-- HEAD OFFICE -->
                  <div style="margin-bottom:10px;">
                    <strong>Head Office :</strong>
                    <br/>
                    <t t-if="o.company_id">
                      <span t-esc="o.company_id.name"/>
                      <br/>
                      <span t-esc="o.company_id.street"/>
                      <br/>
                      <span t-esc="o.company_id.city"/>
                      <t t-if="o.company_id.state_id">, <span t-esc="o.company_id.state_id.name"/></t>
                      <t t-if="o.company_id.zip">
                        <span t-esc="o.company_id.zip"/>
                      </t>
                      <br/>
                      <span t-esc="o.company_id.country_id.name"/>
                    </t>
                  </div>
                  <!-- TO -->
                  <t t-if="partner">
                    <strong>To :</strong>
                    <br/>
                    <!-- PIC -->
                    <t t-if="o.pic_penerima">
                      <span style="font-weight:bold;" t-esc="o.pic_penerima"/>
                      <br/>
                    </t>
                    <!-- COMPANY -->
                    <strong>
                      <span t-esc="partner.commercial_partner_id.name"/>
                    </strong>
                    <br/>
                    <!-- ADDRESS -->
                    <span t-esc="partner.commercial_partner_id.street"/>
                    <br/>
                    <span t-esc="partner.commercial_partner_id.city"/>
                    <t t-if="partner.commercial_partner_id.state_id">
                      ,
                      <span t-esc="partner.commercial_partner_id.state_id.name"/>
                    </t>
                    <t t-if="partner.commercial_partner_id.zip">
                      <span t-esc="partner.commercial_partner_id.zip"/>
                    </t>
                  </t>
                </td>
                <!-- RIGHT -->
                <td style="width:35%; vertical-align:top; background-color:transparent;">
                  <table style="width:100%; border-collapse:collapse; border:none;">
                    <tr>
                      <td style="padding:2px 4px;">
                        <strong>Delivery Date :</strong>
                      </td>
                      <td style="padding:2px 4px; text-align:right; ">
                        <span t-if="o.state=='done'" t-field="o.date_done"/>
                        <span t-else="" t-field="o.scheduled_date"/>
                      </td>
                    </tr>
                    <tr>
                      <td style="padding:2px 4px;">
                        <strong>Delivery No :</strong>
                      </td>
                      <td style="padding:2px 4px; text-align:right;">
                        <span t-field="o.name"/>
                      </td>
                    </tr>
                    <t t-if="o.origin">
                      <tr>
                        <td style="padding:2px 4px;">
                          <strong>
                            <t t-if="is_incoming">No. PO:</t>
                            <t t-elif="is_outgoing">No.SO:</t>
                            <t t-else="">Reference No :</t>
                          </strong>
                        </td>
                        <td style="padding:2px 4px; text-align:right;">
                          <span t-esc="o.origin"/>
                        </td>
                      </tr>
                    </t>
                    <tr>
                      <td style="padding:2px 4px;">
                        <strong>Ship Via :</strong>
                      </td>
                      <td style="padding:2px 4px; text-align:right;">-</td>
                    </tr>
                  </table>
                </td>
              </tr>
            </table>
            <!-- ================= PAGE ================= -->
            <div class="page">
              <!-- ================= TITLE ================= -->
              <div class="mt-4">
                <t t-set="layout_document_title">
                  <span t-out="o.picking_type_id._get_code_report_name()"/>
                  <span t-field="o.name"/>
                </t>
              </div>
              <!-- ================= NOT DONE ================= -->
              <t t-if="o.state != 'done'">
                <p class="mt-1">
                  <span t-if="is_incoming">BARANG YANG AKAN / SEDANG DITERIMA:</span>
                  <span t-if="is_outgoing">BARANG YANG AKAN / SEDANG DIKIRIM:</span>
                </p>
                <table class="table table-sm table-borderless" style="width:100%; border-collapse:collapse; font-size:11px;">
                  <thead>
                    <tr>
                      <th style="background:#3F5E9A;color:#fff;border:1px solid #000;width:18%;">Kode</th>
                      <th style="background:#3F5E9A;color:#fff;border:1px solid #000;width:56%;">Deskripsi</th>
                      <!-- ORDERED -->
                      <th style="background:#3F5E9A;color:#fff;border:1px solid #000;width:8%;text-align:center;">Ordered</th>
                      <!-- RECEIVED / DELIVERED -->
                      <th style="background:#3F5E9A;color:#fff;border:1px solid #000;width:8%;text-align:center;">
                        <span t-if="is_incoming">Received</span>
                        <span t-if="is_outgoing">Delivered</span>
                      </th>
                      <th style="background:#3F5E9A;color:#fff;border:1px solid #000;width:10%;text-align:center;">Satuan</th>
                    </tr>
                  </thead>
                  <tbody>
                    <t t-foreach="o.move_ids.filtered(lambda m: m.product_uom_qty)" t-as="move">
                      <tr>
                        <!-- KODE -->
                        <td style="border:1px solid #000;">
                          <span t-esc="move.product_id.default_code"/>
                        </td>
                        <!-- DESKRIPSI -->
                        <td style="border:1px solid #000;">
                          <span t-out="move.description_picking or move.product_id.name"/>
                        </td>
                        <!-- ORDERED -->
                        <td style="border:1px solid #000;text-align:center;">
                          <span t-out="fmt(move.product_uom_qty or 0)"/>
                        </td>
                        <!-- RECEIVED / DELIVERED (BELUM DONE → qty sementara) -->
                        <td style="border:1px solid #000;text-align:center;">
                          <span t-out="fmt(move.quantity or 0)"/>
                        </td>
                        <!-- SATUAN -->
                        <td style="border:1px solid #000;text-align:center;">
                          <span t-field="move.product_uom"/>
                        </td>
                      </tr>
                    </t>
                  </tbody>
                </table>
              </t>
              <t t-if="o.state != 'done'">
                <table class="header-info" style="width:100%; margin-top:6px; font-size:11px;">
                  <tr>
                    <td style="width:80%; text-align:right; font-weight:bold;">Total Kuantitas</td>
                    <td style="width:20%; text-align:right; border:1px solid #000;">
                      <span t-out="fmt(sum(o.move_ids.mapped('product_uom_qty')))"/>
                    </td>
                  </tr>
                  <tr>
                    <td style="text-align:right; font-weight:bold;">Jumlah Barang</td>
                    <td style="text-align:right; border:1px solid #000;">
                      <span t-out="len(o.move_ids.filtered(lambda m: m.product_uom_qty))"/>
                    </td>
                  </tr>
                </table>
              </t>
              <!-- ================= DONE ================= -->
              <t t-if="o.move_line_ids and o.state=='done'">
                <p class="mt-1">
                  <span t-if="is_incoming">BARANG YANG SUDAH DITERIMA:</span>
                  <span t-if="is_outgoing">BARANG YANG SUDAH DIKIRIM:</span>
                </p>
                <table class="table table-sm table-borderless" style="width:100%; border-collapse:collapse; font-size:11px;">
                  <thead>
                    <tr>
                      <th style="background:#3F5E9A;color:#fff;border:1px solid #000;width:18%;">Kode</th>
                      <th style="background:#3F5E9A;color:#fff;border:1px solid #000;width:56%;">Deskripsi</th>
                      <th style="background:#3F5E9A;color:#fff;border:1px solid #000;width:8%;text-align:center;">Ordered</th>
                      <th style="background:#3F5E9A;color:#fff;border:1px solid #000;width:8%;text-align:center;">
                        <span t-if="is_incoming">Received</span>
                        <span t-if="is_outgoing">Delivered</span>
                      </th>
                      <th style="background:#3F5E9A;color:#fff;border:1px solid #000;width:10%;text-align:center;">Satuan</th>
                    </tr>
                  </thead>
                  <tbody>
                    <t t-foreach="o.move_line_ids" t-as="ml">
                      <tr>
                        <td style="border:1px solid #000;">
                          <span t-esc="ml.product_id.default_code"/>
                        </td>
                        <td style="border:1px solid #000;">
                          <span t-out="ml.description_picking or ml.product_id.name"/>
                        </td>
                        <!-- ORDERED (GR ASLI, DN FIX) -->
                        <td style="border:1px solid #000;text-align:center;">
                          <!-- GR / INCOMING -->
                          <t t-if="is_incoming">
                            <t t-set="ordered_qty" t-value="0"/>
                            <t t-if="ml.move_id and ml.move_id.purchase_line_id">
                              <t t-set="ordered_qty" t-value="ml.move_id.purchase_line_id.product_qty"/>
                            </t>
                            <t t-else="">
                              <t t-set="ordered_qty" t-value="sum([m.product_uom_qty for m in o.move_ids.filtered(lambda m: m.product_id == ml.product_id)])"/>
                            </t>
                            <span t-out="fmt(ordered_qty or 0)"/>
                          </t>
                          <!-- DN / OUTGOING -->
                          <t t-if="is_outgoing">
                            <span t-out="fmt(                         sum([m.product_uom_qty for m in o.move_ids.filtered(lambda m: m.product_id == ml.product_id)])                       )"/>
                          </t>
                        </td>
                        <!-- RECEIVED / DELIVERED -->
                        <td style="border:1px solid #000;text-align:center;">
                          <span t-out="fmt(ml.qty_done or 0)"/>
                        </td>
                        <td style="border:1px solid #000;text-align:center;">
                          <span t-field="ml.product_uom_id"/>
                        </td>
                      </tr>
                    </t>
                  </tbody>
                </table>
              </t>
              <t t-if="o.move_line_ids and o.state == 'done'">
                <table class="header-info" style="width:100%; margin-top:6px; font-size:11px;">
                  <tr>
                    <td style="width:80%; text-align:right; font-weight:bold;">Total Kuantitas</td>
                    <td style="width:20%; text-align:right; border:1px solid #000;">
                      <span t-out="fmt(sum(o.move_line_ids.mapped('qty_done')))"/>
                    </td>
                  </tr>
                  <tr>
                    <td style="text-align:right; font-weight:bold;">Jumlah Barang</td>
                    <td style="text-align:right; border:1px solid #000;">
                      <span t-out="len(o.move_line_ids)"/>
                    </td>
                  </tr>
                </table>
              </t>
              <!-- ================= BACKORDER ================= -->
              <t t-set="backorders" t-value="o.backorder_ids.filtered(lambda x: x.state not in ('done','cancel'))"/>
              <t t-if="backorders">
                <p class="mt-0">
                  <span t-if="is_incoming">BARANG YANG BELUM DITERIMA:</span>
                  <span t-if="is_outgoing">BARANG YANG BELUM DIKIRIM:</span>
                </p>
                <table class="table table-sm table-borderless" style="font-size:11px;">
                  <thead>
                    <tr>
                      <th style="background:#3F5E9A;color:#fff;border:1px solid #000;">Kode</th>
                      <th style="background:#3F5E9A;color:#fff;border:1px solid #000;">Deskripsi</th>
                      <th style="background:#3F5E9A;color:#fff;border:1px solid #000;text-align:center;">Qty</th>
                      <th style="background:#3F5E9A;color:#fff;border:1px solid #000;text-align:center;">Satuan</th>
                    </tr>
                  </thead>
                  <tbody>
                    <t t-foreach="backorders.mapped('move_ids').filtered(lambda m: m.product_uom_qty)" t-as="bo">
                      <tr>
                        <td style="border:1px solid #000;">
                          <span t-esc="bo.product_id.default_code"/>
                        </td>
                        <td style="border:1px solid #000;">
                          <span t-out="bo.description_picking or bo.product_id.name"/>
                        </td>
                        <td style="border:1px solid #000;text-align:center;">
                          <span t-out="fmt(bo.product_uom_qty)"/>
                        </td>
                        <td style="border:1px solid #000;text-align:center;">
                          <span t-field="bo.product_uom"/>
                        </td>
                      </tr>
                    </t>
                  </tbody>
                </table>
              </t>
              <t t-if="backorders">
                <table class="header-info" style="width:100%; margin-top:6px; font-size:11px;">
                  <tr>
                    <td style="width:80%; text-align:right; font-weight:bold;">Total Kuantitas</td>
                    <td style="width:20%; text-align:right; border:1px solid #000;">
                      <span t-out="fmt(sum(backorders.mapped('move_ids').mapped('product_uom_qty')))"/>
                    </td>
                  </tr>
                  <tr>
                    <td style="text-align:right; font-weight:bold;">Jumlah Barang</td>
                    <td style="text-align:right; border:1px solid #000;">
                      <span t-out="len(backorders.mapped('move_ids').filtered(lambda m: m.product_uom_qty))"/>
                    </td>
                  </tr>
                </table>
              </t>
              <!-- ================= FOOTER ================= -->
              <div style="margin-top:25px; font-size:11px; page-break-inside:avoid;">
                <t t-set="po_note" t-value="o.note or ''"/>
                <t t-if="o.move_ids and o.move_ids[0].purchase_line_id and o.move_ids[0].purchase_line_id.order_id">
                  <t t-set="po_note" t-value="o.move_ids[0].purchase_line_id.order_id.note or po_note"/>
                </t>
                <table style="width:100%;">
                  <tr>
                    <td style="width:55%;vertical-align:top;">
                      <div t-if="po_note" t-raw="po_note"/>
                    </td>
                    <td style="width:22%;text-align:center;">
                      <strong>Dikirim Oleh</strong>
                      <div style="height:90px;"/>
                      <div style="border-top:1px solid #000;"/>
                    </td>
                    <td style="width:23%;text-align:center;">
                      <strong>Diterima Oleh</strong>
                      <div style="height:90px;"/>
                      <div style="border-top:1px solid #000;"/>
                    </td>
                  </tr>
                </table>
              </div>
            </div>
          </t>
        </t>
    </xpath>
  </template>
</odoo>