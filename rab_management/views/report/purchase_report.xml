<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
<template id="report_purchaseorder_custom" inherit_id="purchase.report_purchaseorder_document">
  <xpath expr="." position="replace">
    <t t-call="web.external_layout">
      <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>
      <t t-set="address">
        <div>
          <div style="font-weight:600; margin-bottom:4px;">
            <strong class="d-block mt-3">Vendor</strong>
          </div>
          <t t-if="o.partner_id.name">
            <div style="font-weight:600; font-size:12px;">
              <span t-esc="o.partner_id.name"/>
            </div>
            <t t-if="o.partner_id.commercial_company_name and o.partner_id.commercial_company_name != o.partner_id.name">
              <div style="font-size:11px; color:#333; margin-bottom:6px;">
                <span t-esc="o.partner_id.commercial_company_name"/>
              </div>
            </t>
          </t>
          <t t-elif="o.partner_id.commercial_company_name">
            <div style="font-weight:600; font-size:12px; margin-bottom:6px;">
              <span t-esc="o.partner_id.commercial_company_name"/>
            </div>
          </t>
          <div t-field="o.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;,&quot;phone&quot;], &quot;no_marker&quot;: True}"/>
        </div>
      </t>
      <!--BLOK ALAMAT KTI-->
      <t t-set="information_block">
        <strong class="d-block mt-3">Order By </strong>
        <div t-field="o.user_id"/>
        <div>
          <strong>Dikirim Ke: </strong>
          <span t-esc="o.picking_type_id.warehouse_id.name or ''"/>
          <div style="margin-top:6px;" t-field="o.picking_type_id.warehouse_id.partner_id" t-options="{'widget':'contact','fields':['address','phone'],'no_marker':True}"/>
        </div>
      </t>
      <div class="page">
        <div class="oe_structure"/>
        <!--Judul dokumen -->
        <div class="mt-4">
          <t t-set="layout_document_title">
            <t t-if="o.state in ['draft', 'sent', 'to approve']">
              Request for Quotation #
              <span t-field="o.name"/>
              <hr style="margin-top:4px; margin-bottom:4px; border:0; border-top:1px solid #000;"/>
            </t>
            <t t-if="o.state == 'purchase'">
              Purchase Order #
              <span t-field="o.name"/>
            </t>
            <t t-if="o.state == 'cancel'">
              Cancelled Purchase Order #
              <span t-field="o.name"/>
            </t>
          </t>
        </div>
        <!-- Info atas PO -->
        <!--KODE MODIFIKASI-->
        <div id="informations" class="row mb-4">
          <div t-if="o.user_id" class="col">
            <strong>Buyer</strong>
            <div t-field="o.user_id"/>
          </div>
          <div t-if="o.partner_ref" class="col">
            <strong>Your Order Reference</strong>
            <div t-field="o.partner_ref"/>
          </div>
          <div t-if="o.state == 'purchase' and o.date_approve" class="col-3 bm-2">
            <strong>Order Date:</strong>
            <p t-field="o.date_approve" t-options="{'date_only': 'true'}" class="m-0"/>
          </div>
          <div t-elif="o.date_order" class="col-2 bm-2">
            <strong>Order Deadline:</strong>
            <p t-field="o.date_order" t-options="{'date_only': 'true'}" class="m-0"/>
          </div>
          <div t-if="o.date_planned" class="col-2 bm-2">
            <strong>Expected Arrival:</strong>
            <p t-field="o.date_planned" t-options="{'date_only': 'true'}" class="m-0"/>
          </div>
          <div t-if="o.incoterm_id" class="col-2 bm-2">
            <strong>Incoterm:</strong>
            <p t-if="o.incoterm_location">
              <span t-field="o.incoterm_id.code"/>
              <br/>
              <span t-field="o.incoterm_location"/>
            </p>
            <p t-else="" t-field="o.incoterm_id.code" class="m-0"/>
          </div>
        </div>
        <!-- TEKS DI ATAS TABEL -->
        <p style="font-size: 11px; margin-bottom: 4px;">Please supply materials and/or services as follows:</p>
        <!-- TABEL PO MODEL KTI -->
        <table class="table" style="width:100%; border-collapse: collapse; font-size: 11px;">
          <thead>
            <tr>
              <th style="background:#3F5E9A; color:#FFFFFF; padding:4px; border:1px solid #000; width:10%;">Item Code</th>
              <th style="background:#3F5E9A; color:#FFFFFF; padding:4px; border:1px solid #000; width:50%;">Description</th>
              <th style="background:#3F5E9A; color:#FFFFFF; padding:4px; border:1px solid #000; text-align:center; width:8%;">Qty</th>
              <th style="background:#3F5E9A; color:#FFFFFF; padding:4px; border:1px solid #000; text-align:right; width:12%;">Price</th>
              <th style="background:#3F5E9A; color:#FFFFFF; padding:4px; border:1px solid #000; text-align:right; width:10%;">Discount</th>
              <th style="background:#3F5E9A; color:#FFFFFF; padding:4px; border:1px solid #000; text-align:right; width:10%;">Amount</th>
            </tr>
          </thead>
          <tbody>
            <!-- Hanya line normal (bukan section/note) -->
            <t t-foreach="o.order_line.filtered(lambda l: not l.display_type and l.product_qty != 0)" t-as="line">
              <tr>
                <!-- ITEM CODE -->
                <td style="border:1px solid #000; padding:3px;">
                  <span t-esc="line.product_id.default_code or ''"/>
                </td>
                <!-- DESCRIPTION -->
                <td style="border:1px solid #000; padding:3px;">
                  <span t-field="line.name"/>
                </td>
                <!-- QTY -->
                <td style="border:1px solid #000; padding:3px; text-align:center;">
                  <span t-field="line.product_qty"/>
                </td>
                <!-- PRICE -->
                <td style="border:1px solid #000; padding:3px; text-align:right;">
                  <span t-field="line.price_unit"/>
                </td>
                <!-- DISCOUNT -->
                <td style="border:1px solid #000; padding:3px; text-align:right;">
                  <span t-field="line.discount"/>
                  %
                </td>
                <!-- AMOUNT -->
                <td style="border:1px solid #000; padding:3px; text-align:right;">
                  <span t-field="line.price_subtotal" t-options="{'widget': 'monetary',                                                   'display_currency': o.currency_id}"/>
                </td>
              </tr>
            </t>
          </tbody>
        </table>
        <!--BAGIAN TOTAL-->
        <div class="row" style="margin-top:10px;">
          <!--CATATATN SISI KIRI-->
          <div class="col-8" style="font-size:11px; padding:0; border-top:1px solid #000; padding-top:0;">
            <div t-field="o.note" style="white-space:pre-wrap; margin:0; padding:0; line-height:1;"/>
          </div>
          <!-- RIGHT: TOTALS -->
          <div class="col-4">
            <table class="o_total_table table table-borderless">
              <t t-call="purchase.document_tax_totals">
                <t t-set="tax_totals" t-value="o.tax_totals"/>
                <t t-set="currency" t-value="o.currency_id"/>
              </t>
            </table>
          </div>
        </div>
        <hr style="margin-top:6px; margin-bottom:6px; border:0; border-top:1px solid #000;"/>
        <!--BLOK TTD-->
        <div style="page-break-inside: avoid; page-break-before: auto; page-break-after: auto; width:100%; margin-top:25px;">
          <div class="row" style="font-size:11px; text-align:center;">
            <!-- PREPARED BY -->
            <div class="col-4" style="page-break-inside: avoid;">
              <strong>Prepared By</strong>
              <div style="height:100px;"/>
              <span t-esc="o.user_id.name or ''"/>
            </div>
            <!-- APPROVED BY ACCOUNTING -->
            <div class="col-4" style="page-break-inside: avoid;">
              <strong>Approved By (Accounting)</strong>
              <div style="height:100px;"/>
              <span>MEGA FA</span>
            </div>
            <!-- APPROVED BY DIRECTOR -->
            <div class="col-4" style="page-break-inside: avoid;">
              <strong>Approved By (Director)</strong>
              <div style="height:100px;"/>
              <span>Falah</span>
            </div>
          </div>
        </div>
        <!-- Portal link -->
        <t t-set="base_address" t-value="o.env['ir.config_parameter'].sudo().get_param('web.base.url')"/>
        <t t-set="portal_url" t-value="base_address + '/my/purchase/' + str(o.id) + '#portal_connect_software_modal'"/>
        <div t-if="any(u._is_portal() for u in o.partner_id.user_ids) and o._get_edi_builders()" class="text-center">
          <a t-att-href="portal_url">Connect your software</a>
          with
          <t t-out="o.company_id.name"/>
          to create quotes automatically.
        </div>
      </div>
    </t>
  </xpath>
</template>


  </data>
</odoo>
