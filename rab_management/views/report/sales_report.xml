<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <template id="report_saleorder_custom" inherit_id="sale.report_saleorder_document">
      <xpath expr="." position="replace">
        <t t-call="web.external_layout">
          <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
          <t t-set="forced_vat" t-value="doc.fiscal_position_id.foreign_vat"/>
          <!-- So that it appears in the footer of the report instead of the company VAT if it's set -->
          <t t-set="address">
            <t t-set="pname" t-value="(doc.partner_id.name or '').strip()"/>
            <t t-set="pcompany" t-value="(doc.partner_id.commercial_company_name or '').strip()"/>
            <t t-set="phone" t-value="(doc.partner_id.phone or '').strip()"/>
            <t t-set="raw_addr" t-value="(doc.partner_id.contact_address or '').strip()"/>
            <t t-set="addr_lines" t-value="[ln.strip() for ln in raw_addr.splitlines() if ln.strip()]"/>
            <t t-set="addr_filtered" t-value="[ln for ln in addr_lines if ln and ln not in [pname, pcompany]]"/>
            <t t-set="clean_addr" t-value="'\\n'.join(addr_filtered)"/>
            <t t-set="wrap_len" t-value="80"/>
            <t t-set="wrapped_lines" t-value="[chunk for ln in addr_filtered for chunk in [ln[i:i+wrap_len] for i in range(0, len(ln), wrap_len)]]"/>
            <div style="page-break-inside:avoid;">
              <!-- Header -->
              <div style="font-weight:600; margin-bottom:4px; font-size:12px;">
                <strong class="d-block mt-3">KEPADA</strong>
              </div>
              <!-- Name & Company (follow supplier concept) -->
              <div style="font-weight:600; font-size:12px; margin-bottom:2px;">
                <t t-if="pname and pname != ''">
                  <span t-esc="pname"/>
                </t>
              </div>
              <t t-if="pcompany and pcompany != '' and pcompany != pname">
                <div style="font-size:12px; color:#333; margin-bottom:6px;">
                  <span t-esc="pcompany"/>
                </div>
              </t>
              <!-- Address (cleaned & wrapped) -->
              <div style="font-size:11px; line-height:1.5; white-space:normal; color:#222; max-height:220px; overflow:hidden;">
                <t t-foreach="wrapped_lines" t-as="ln">
                  <div>
                    <t t-esc="ln"/>
                  </div>
                </t>
                <!-- fallback: if no address lines, render contact widget address+phone -->
                <t t-if="not wrapped_lines">
                  <div style="margin-top:4px;">
                    <div t-field="doc.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;,&quot;phone&quot;], &quot;no_marker&quot;: True}"/>
                  </div>
                </t>
              </div>
              <!-- Phone -->
              <t t-if="phone">
                <div style="margin-top:6px; font-size:12px; color:#333;">
                  <strong>Phone:</strong>
                  <span t-esc="phone"/>
                </div>
              </t>
              <!-- NPWP / VAT -->
              <p t-if="doc.partner_id.vat" style="margin-top:6px; font-size:12px; font-weight:600; margin-bottom:0;">
                NPWP:
                <span t-field="doc.partner_id.vat"/>
              </p>
            </div>
          </t>
          <t t-if="doc.partner_shipping_id == doc.partner_invoice_id                             
            and doc.partner_invoice_id != doc.partner_id                           
                or doc.partner_shipping_id != doc.partner_invoice_id">
            <t t-set="information_block">
              <strong>
                <t t-if="doc.partner_shipping_id == doc.partner_invoice_id">Invoicing and Shipping Address</t>
                <t t-else="">Invoicing Address</t>
              </strong>
              <div t-field="doc.partner_invoice_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True, &quot;phone_icons&quot;: True}"/>
              <t t-if="doc.partner_shipping_id != doc.partner_invoice_id">
                <strong class="d-block mt-3">Shipping Address</strong>
                <div t-field="doc.partner_shipping_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True, &quot;phone_icons&quot;: True}"/>
              </t>
            </t>
          </t>
          <div class="page">
            <div class="oe_structure"/>
            <t t-set="is_proforma" t-value="env.context.get('proforma', False) or is_pro_forma"/>
            <t t-set="layout_document_title">
              <span t-if="is_proforma">Pro-Forma Invoice # </span>
              <span t-elif="doc.state in ['draft','sent']">Quotation # </span>
              <span t-else="">Order # </span>
              <span t-field="doc.name">SO0000</span>
            </t>
            <div class="row mb-4" id="informations">
              <div t-if="doc.client_order_ref" class="col" name="informations_reference">
                <strong>Your Reference</strong>
                <div t-field="doc.client_order_ref">SO0000</div>
              </div>
              <div t-if="doc.date_order" class="col" name="informations_date">
                <strong t-if="is_proforma">Issued Date</strong>
                <strong t-elif="doc.state in ['draft', 'sent']">Quotation Date</strong>
                <strong t-else="">Order Date</strong>
                <div t-field="doc.date_order" t-options="{&quot;widget&quot;: &quot;date&quot;}">2023-12-31</div>
              </div>
              <div t-if="doc.validity_date and doc.state in ['draft', 'sent']" class="col" name="expiration_date">
                <strong>Expiration</strong>
                <div t-field="doc.validity_date">2023-12-31</div>
              </div>
              <div t-if="doc.commitment_date" class="col" name="delivery_date">
                <strong>Delivery Date</strong>
                <div t-field="doc.commitment_date" t-options="{'widget': 'date'}">2023-12-31</div>
              </div>
              <div t-if="doc.user_id.name" class="col">
                <strong>Salesperson</strong>
                <div t-field="doc.user_id">Mitchell Admin</div>
              </div>
            </div>
            <t t-set="lines_to_report" t-value="doc._get_order_lines_to_report()"/>
            <t t-set="display_discount" t-value="any(l.discount for l in lines_to_report)"/>
            <t t-set="hide_taxes_details" t-value="False"/>
            <t t-set="display_taxes" t-value="not hide_taxes_details and any(l._has_taxes() for l in lines_to_report)"/>
            <!--LAYOUT KTI-->
            <div class="oe_structure"/>
            <table class="o_has_total_table table o_main_table table-borderless" style="border-collapse:collapse; width:100%; font-size:11px; line-height:1.12;">
              <thead style="display: table-row-group;">
                <tr style="background:#3e5d86; color:#fff;">
                  <th style="padding:4px 6px; text-align:left; width:110px; color:#ffffff !important;">Item Code</th>
                  <th style="padding:4px 6px; text-align:left; color:#ffffff !important;">Description</th>
                  <th style="padding:4px 6px; text-align:center; width:50px; color:#ffffff !important;">Qty</th>
                  <th style="padding:4px 6px; text-align:left; width:50px; color:#ffffff !important;">Unit</th>
                  <th style="padding:4px 6px; text-align:right; width:90px; color:#ffffff !important; white-space:nowrap;">Price</th>
                  <th t-if="display_discount" style="padding:4px 6px; text-align:right; width:60px; color:#ffffff !important;">Discount</th>
                  <th t-if="display_taxes" style="padding:4px 6px; text-align:right; width:90px; color:#ffffff !important;">Taxes</th>
                  <th style="padding:4px 6px; text-align:right; width:100px; color:#ffffff !important; white-space:nowrap;">Total</th>
                </tr>
              </thead>
              <tbody class="sale_tbody">
                <t t-set="current_section" t-value="None"/>
                <t t-set="current_subsection" t-value="None"/>
                <t t-set="price_field" t-value="'price_total' if hide_taxes_details else 'price_subtotal'"/>
                <t t-foreach="lines_to_report" t-as="line">
                  <t t-set="is_note" t-value="line.display_type == 'line_note'"/>
                  <t t-set="is_section" t-value="line.display_type == 'line_section'"/>
                  <t t-set="is_subsection" t-value="line.display_type == 'line_subsection'"/>
                  <t t-set="is_combo" t-value="line.product_type == 'combo'"/>
                  <!-- if composition not collapsed => render normal rows (section/note/combo/product) -->
                  <t t-if="not line.collapse_composition">
                    <!-- SECTION -->
                    <t t-if="is_section">
                      <tr name="tr_section" t-att-class="'fw-bolder o_line_section'">
                        <t t-set="show_section_total" t-value="is_section or not line.parent_id.collapse_prices"/>
                        <t t-set="section_name_colspan" t-value="4 + (1 if display_discount else 0) + (1 if display_taxes else 0)"/>
                        <td t-att-colspan="section_name_colspan" style="padding:6px;">
                          <span t-field="line.name"/>
                        </td>
                        <td t-if="show_section_total" class="text-end o_price_total" style="padding:6px;">
                          <span t-out="line._get_section_totals(price_field)" class="text-nowrap" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                        </td>
                      </tr>
                      <!-- SUBSECTION -->
                    </t>
                    <t t-elif="is_subsection">
                      <tr name="tr_subsection" t-att-class="'fw-bold o_line_subsection'">
                        <td colspan="99" style="padding:6px;">
                          <span t-field="line.name"/>
                        </td>
                      </tr>
                      <!-- NOTE -->
                    </t>
                    <t t-elif="is_note">
                      <tr name="tr_note" class="fst-italic o_line_note">
                        <td colspan="99" style="padding:6px;">
                          <span t-field="line.name"/>
                        </td>
                      </tr>
                      <!-- COMBO -->
                    </t>
                    <t t-elif="is_combo">
                      <tr name="tr_combo" class="fw-bold o_line_subsection">
                        <td style="padding:6px; vertical-align:top;">
                          <t t-esc="line.product_id.default_code or '-'"/>
                        </td>
                        <td style="padding:6px; vertical-align:top;" colspan="2">
                          <span t-field="line.name"/>
                          x
                          <span t-field="line.product_uom_qty" t-options="{'widget': 'integer'}"/>
                        </td>
                        <td style="padding:6px; text-align:right; vertical-align:top;">
                          <span t-out="line._get_combo_totals(price_field)" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                        </td>
                        <td t-if="display_discount" style="padding:6px; text-align:right;"/>
                        <td t-if="display_taxes" style="padding:6px; text-align:right;"/>
                        <td style="padding:6px; text-align:right;"/>
                      </tr>
                      <!-- NORMAL PRODUCT -->
                    </t>
                    <t t-else="">
                      <tr name="tr_product" style="vertical-align:middle; line-height:1.12;">
                        <td style="padding:6px; vertical-align:middle; white-space:nowrap;">
                          <t t-esc="line.product_id.default_code or '-'"/>
                        </td>
                        <td style="padding:6px; vertical-align:middle; word-break:break-word; max-width:420px;">
                          <span t-field="line.name"/>
                        </td>
                        <td style="padding:6px; text-align:center; vertical-align:middle; white-space:nowrap;">
                          <span t-field="line.product_uom_qty" t-options="{'widget':'float','precision': 2}"/>
                        </td>
                        <td style="padding:6px; vertical-align:middle; white-space:nowrap;">
                          <span t-field="line.product_uom_id"/>
                        </td>
                        <td style="padding:6px; text-align:right; vertical-align:middle; white-space:nowrap;">
                          <span t-if="not collapse_prices" t-field="line.price_unit" t-options="{'widget': 'monetary', 'display_currency': line.currency_id}"/>
                        </td>
                        <td t-if="display_discount" style="padding:6px; text-align:right; vertical-align:middle; white-space:nowrap;">
                          <t t-if="not collapse_prices">
                            <span t-field="line.discount"/>
                          </t>
                        </td>
                        <t t-set="taxes" t-value="', '.join(tax.tax_label for tax in line.tax_ids if tax.tax_label)"/>
                        <td t-if="display_taxes" style="padding:6px; text-align:right; vertical-align:middle; white-space:nowrap;">
                          <span t-out="taxes"/>
                        </td>
                        <td style="padding:6px; text-align:right; vertical-align:middle; white-space:nowrap;">
                          <t t-if="not collapse_prices">
                            <span t-if="price_field == 'price_subtotal'" t-field="line.price_subtotal" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                            <span t-else="" t-field="line.price_total" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                          </t>
                        </td>
                      </tr>
                    </t>
                  </t>
                  <!-- grouped section summary (when collapse_composition is True) -->
                  <t t-else="">
                    <tr t-foreach="line._get_grouped_section_summary(display_taxes)" t-as="section_line" name="tr_section_group" class="o_line_section">
                      <td style="padding:6px;">
                        <span t-field="line.name"/>
                      </td>
                      <td style="padding:6px; text-align:center;">
                        <span>1.00 Units</span>
                      </td>
                      <td style="padding:6px; text-align:right;">
                        <span name="price_subtotal_section_grouped" t-out="section_line['price_subtotal']" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                      </td>
                      <td t-if="display_discount" style="padding:6px;"/>
                      <td t-if="display_taxes" style="padding:6px; text-align:right;">
                        <span t-out="', '.join(section_line['tax_labels'])"/>
                      </td>
                      <td style="padding:6px; text-align:right;">
                        <span t-out="section_line[price_field]" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                      </td>
                    </tr>
                  </t>
                </t>
              </tbody>
            </table>
            <table style="width:100%; border-collapse:separate; border:0; font-size:11px; page-break-inside:avoid; background:transparent;">
              <tr>
                <!-- LEFT: notes -->
                <td style="vertical-align:top; padding-right:12px; width:65%; border:0; background:transparent;">
                  <strong>Description :</strong>
                  <div style="margin-top:6px;">
                    <t t-if="doc.note">
                      <div t-field="doc.note"/>
                    </t>
                    <t t-else="">
                      <p style="margin:0; font-size:10.5px; color:#333;">
                        *Harga dan Stock tidak mengikat, sewaktu-waktu berubah.
                        <br/>
                        *Item dan Qty penawaran mengikat.
                        <br/>
                        *Ketersediaan Barang : Stock berjalan.
                        <br/>
                        *Franco : Cakung, Jakarta
                        <br/>
                        *Validity : 1 week
                        <br/>
                        *Payment : TOP 30 Hari
                      </p>
                    </t>
                  </div>
                  <div style="margin-top:8px; font-size:10px;">
                    <strong>No. Rek PT. Karya Teknologi Indonesia</strong>
                    <br/>
                    BCA : 0189896699
                  </div>
                </td>
                <!-- RIGHT: totals -->
                <td style="vertical-align:bottom; padding-left:12px; width:35%; border:0 #000; background:transparent;">
                  <table style="width:100%; border-collapse:separate; border:1px solid #e6e9ee; border-radius:4px; font-size:11px; background:transparent;">
                    <tr style="border-bottom:1px solid #eee;">
                      <td style="padding:10px 14px; width:60%; border:0; vertical-align:middle; font-weight:600;">Sub Total</td>
                      <td style="padding:10px 14px; text-align:right; width:40%; border:0; vertical-align:middle;">
                        <span t-field="doc.amount_untaxed" t-options="{'widget':'monetary','display_currency': doc.currency_id}"/>
                      </td>
                    </tr>
                    <tr style="border-bottom:1px solid #eee;">
                      <td style="padding:10px 14px; border:0; vertical-align:middle;">Diskon</td>
                      <td style="padding:10px 14px; text-align:right; border:0; vertical-align:middle;">
                        <t t-if="'amount_discount' in doc._fields">
                          <span t-field="doc.amount_discount" t-options="{'widget':'monetary','display_currency': doc.currency_id}"/>
                        </t>
                        <t t-else="">0</t>
                      </td>
                    </tr>
                    <tr style="border-bottom:1px solid #eee;">
                      <td style="padding:10px 14px; border:0; vertical-align:middle;">PPN</td>
                      <td style="padding:10px 14px; text-align:right; border:0; vertical-align:middle;">
                        <span t-field="doc.amount_tax" t-options="{'widget':'monetary','display_currency': doc.currency_id}"/>
                      </td>
                    </tr>
                    <tr>
                      <td style="padding:12px 14px; border:0; vertical-align:middle; font-weight:700;">Total</td>
                      <td style="padding:12px 14px; text-align:right; border:0; vertical-align:middle;">
                        <div style="display:inline-block; min-width:140px; padding:8px 14px; background:#3e5d86; color:#fff; font-weight:700; border-radius:4px; text-align:right;">
                          <span t-field="doc.amount_total" t-options="{'widget':'monetary','display_currency': doc.currency_id}"/>
                        </div>
                      </td>
                    </tr>
                  </table>
                  <div style="height:22px;"/>
                  <div style="text-align:center; margin-top:4px;">
                    <div style="font-size:11px;">Disetujui Oleh</div>
                    <div style="margin-top:100px; font-weight:700; text-decoration:underline;">
                      <t t-esc="doc.company_id.partner_id.name or 'Syamsul Falah'"/>
                    </div>
                    <div style="font-size:10px;">(Authorized Signatory)</div>
                  </div>
                </td>
              </tr>
            </table>
          </div>
        </t>
      </xpath>
    </template>
  </data>
</odoo>