<odoo>
    <record id="view_project_equipment_master_list" model="ir.ui.view">
        <field name="name">project.equipment.master.list</field>
        <field name="model">project.equipment.master</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="product_id"/>
                <field name="total_qty"/>
                <field name="qty_on_site"/>
                <field name="qty_beli"/>
                <field name="uom_id"/>
                <!-- <field name="unit_price" string="Unit Price"/> -->
                <!-- <field name="subtotal" string="Subtotal"/> -->
                <field name="rab_sale_price" string="Harga RAB" readonly="1" optional="show"/>
                <field name="rab_subtotal" string="Subtotal RAB" readonly="1" optional="show"/>
            </list>
        </field>
    </record>
</odoo>
