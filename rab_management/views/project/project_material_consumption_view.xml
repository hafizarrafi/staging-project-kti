<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_project_material_consumption_tree" model="ir.ui.view">
        <field name="name">project.material.consumption.list</field>
        <field name="model">project.material.consumption</field>
        <field name="arch" type="xml">
            <list string="Material Consumptions">
                <field name="name"/>
                <field name="project_id"/>
                <field name="date"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="view_project_material_consumption_form" model="ir.ui.view">
        <field name="name">project.material.consumption.form</field>
        <field name="model">project.material.consumption</field>
        <field name="arch" type="xml">
            <form string="Material Consumption tracking">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_generate_picking" string="Generate Consumption DO" type="object" class="btn-primary" invisible="state != 'confirmed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id" readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="picking_id" invisible="not picking_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Consumption Lines" name="lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom" create="0">
                                    <field name="task_id" readonly="1"/>
                                    <field name="product_id" readonly="1"/>
                                    <field name="qty_available" readonly="1" string="Stok (uom)"/>
                                    <field name="qty_required_kg" readonly="1" string="Dibutuhkan (kg)"/>
                                    <field name="qty_remaining" readonly="1" string="Sisa (kg)"/>
                                    <field name="qty_used" string="Aktual (kg)" sum="Total Aktual"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_project_material_consumption" model="ir.actions.act_window">
        <field name="name">Material Consumptions</field>
        <field name="res_model">project.material.consumption</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
