<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_project_material_consumption_tree" model="ir.ui.view">
        <field name="name">project.material.consumption.list</field>
        <field name="model">project.material.consumption</field>
        <field name="arch" type="xml">
            <list string="Material Consumption Dashboards">
                <field name="project_id"/>
                <field name="date"/>
            </list>
        </field>
    </record>

    <record id="view_project_material_consumption_form" model="ir.ui.view">
        <field name="name">project.material.consumption.form</field>
        <field name="model">project.material.consumption</field>
        <field name="arch" type="xml">
            <form string="Stock Management">
                <header>
                    <button name="action_generate_picking" string="Generate Selected DO" type="object" class="btn-primary" 
                            confirm="Are you sure you want to generate Delivery Orders for selected items?"/>
                    <button name="action_refresh_requirements" string="Refresh Requirements" type="object" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="project_id" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="display_stock_location" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Inventory" name="inventory">
                            <field name="stock_quant_ids" readonly="1">
                                <list string="Project Inventory">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="product_uom_id" string="UoM"/>
                                </list>
                            </field>
                        </page>
                        <page string="Consumption" name="lines">
                            <!-- TOP TABLE: AGGREGATED SUMMARY -->
                            <separator string="1. Item yang Akan Diterbitkan (Agregat)"/>
                            <field name="summary_ids" readonly="1">
                                <list string="Aggregated DO List">
                                    <field name="product_id"/>
                                    <field name="total_weight_kg" string="Total Berat (kg)"/>
                                    <field name="qty_to_issue_unit" string="Issue Units (rounded)" class="font-weight-bold"/>
                                </list>
                            </field>

                            <!-- ACTION BUTTONS -->
                            <div class="o_row pt-3 pb-3">
                                <button name="action_calculate_summary" string="Kalkulasi Pilihan (Agregat)" type="object" class="btn-primary me-2"/>
                                <button name="action_generate_picking" string="Generate Delivery Order (DO)" type="object" class="btn-success" 
                                        confirm="Konfirmasi pembuatan DO untuk item di atas?"/>
                            </div>

                            <!-- BOTTOM TABLE: INDIVIDUAL REQUIREMENTS -->
                            <separator string="2. Daftar Kebutuhan (Pilih untuk Agregasi)"/>
                            <field name="line_ids">
                                <list editable="bottom" create="0" delete="0" decoration-muted="is_fully_issued">
                                    <field name="is_fully_issued" column_invisible="True"/>
                                    <field name="is_selected" string="Select" readonly="is_fully_issued"/>
                                    <field name="parent_task_display_id" readonly="1" string="Task Utama"/>
                                    <field name="subtask_display_name" readonly="1" string="Subtask"/>
                                    <field name="product_id" readonly="1"/>
                                    <field name="qty_available" readonly="1" string="Stok site"/>
                                    <field name="qty_required_kg" readonly="1" string="Butuh (kg)"/>
                                    <field name="qty_to_issue_unit" readonly="1" string="Req. Unit (est.)"/>
                                    <field name="qty_issued_unit" readonly="1" string="Issued Unit"/>
                                </list>
                            </field>
                        </page>
                        <page string="Issue Logs" name="issue_logs">
                            <field name="issue_ids" readonly="1">
                                <list string="Material Issue Logs">
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="picking_id"/>
                                    <field name="state" widget="badge" decoration-success="state == 'confirmed'" decoration-danger="state == 'cancel'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_project_material_consumption" model="ir.actions.act_window">
        <field name="name">Stock Management</field>
        <field name="res_model">project.material.consumption</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
