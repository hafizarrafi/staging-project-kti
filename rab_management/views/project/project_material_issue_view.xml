<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_project_material_issue_tree" model="ir.ui.view">
        <field name="name">project.material.issue.list</field>
        <field name="model">project.material.issue</field>
        <field name="arch" type="xml">
            <list string="Material Issue Logs" create="0">
                <field name="name"/>
                <field name="project_id"/>
                <field name="date"/>
                <field name="picking_id"/>
                <field name="state" widget="badge" decoration-success="state == 'confirmed'" decoration-danger="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <record id="view_project_material_issue_form" model="ir.ui.view">
        <field name="name">project.material.issue.form</field>
        <field name="model">project.material.issue</field>
        <field name="arch" type="xml">
            <form string="Material Issue Log" create="0" edit="0">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="picking_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Issued Items" name="lines">
                            <field name="line_ids">
                                <list>
                                    <field name="task_id"/>
                                    <field name="product_id"/>
                                    <field name="qty_issue_unit" string="Quantity (unit)"/>
                                    <field name="qty_required_kg" string="Original Req (kg)"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_project_material_issue" model="ir.actions.act_window">
        <field name="name">Material Issue Logs</field>
        <field name="res_model">project.material.issue</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Historial log of material issues will appear here.
            </p>
        </field>
    </record>

</odoo>
