<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_stock_onsite_wizard_form" model="ir.ui.view">
        <name>project.stock.onsite.wizard.form</name>
        <model>project.stock.onsite.wizard</model>
        <arch type="xml">
            <form string="Initialize Stock On Site">
                <group>
                    <group>
                        <field name="project_id" readonly="1" force_save="1"/>
                    </group>
                    <group>
                        <field name="location_id"/>
                    </group>
                </group>
                <notebook>
                    <page string="Material Lines" name="material_lines">
                        <field name="line_ids">
                            <list editable="bottom">
                                <field name="product_id" options="{'no_create': True, 'no_open': True}"/>
                                <field name="quantity"/>
                                <field name="uom_id"/>
                            </list>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button name="action_confirm" string="Confirm &amp; Apply Stock" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </arch>
    </record>

    <record id="action_project_stock_onsite_wizard" model="ir.actions.act_window">
        <name>Initialize Stock On Site</name>
        <res_model>project.stock.onsite.wizard</res_model>
        <view_mode>form</view_mode>
        <target>new</target>
    </record>
</odoo>
