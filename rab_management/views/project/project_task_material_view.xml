<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add Material Needed tab to Project Task -->
    <record id="view_task_form2_inherit_material_needed" model="ir.ui.view">
        <field name="name">project.task.form.inherit.material.needed</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">

            <xpath expr="//notebook" position="inside">
                <page string="Material yang diperlukan">
                    <field name="material_needed_ids"
                           context="{
                               'tree_view_ref': 'rab_management.view_project_task_material_list'
                           }"/>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
