<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_project_material_consumption_wizard_form" model="ir.ui.view">
        <field name="name">project.material.consumption.wizard.form</field>
        <field name="model">project.material.consumption.wizard</field>
        <field name="arch" type="xml">
            <form string="Input Material Consumption">
                <group>
                    <group>
                        <field name="project_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="date"/>
                    </group>
                </group>
                <notebook>
                    <page string="Consumption Input">
                        <field name="line_ids">
                            <list editable="bottom" create="0">
                                <field name="task_id" readonly="1" string="Task/Subtask"/>
                                <field name="product_id" readonly="1" string="Material"/>
                                <field name="qty_available" readonly="1" string="Stok (uom)"/>
                                <field name="qty_required_kg" readonly="1" string="Dibutuhkan (kg)"/>
                                <field name="qty_remaining_kg" readonly="1" string="Sisa (kg)"/>
                                <field name="qty_input" string="Aktual (kg)"/>
                            </list>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button name="action_process" string="Process Consumption" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_project_material_consumption_wizard" model="ir.actions.act_window">
        <field name="name">Material Consumption</field>
        <field name="res_model">project.material.consumption.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
