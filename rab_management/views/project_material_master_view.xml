<odoo>
  <record id="view_project_material_master_list" model="ir.ui.view">
    <field name="name">project.material.master.list</field>
    <field name="model">project.material.master</field>
    <field name="arch" type="xml">
      <list editable="bottom" >
        <field name="product_id"/>
        <field name="total_weight" string="Volume Estimasi (kg)" readonly="not is_manual" decoration-muted="not is_manual" />
        <field name="product_weight" string="Weight / Unit (kg)" readonly="1" decoration-muted="1"/>
        <field name="total_qty" readonly="not is_manual" decoration-muted="not is_manual" />
        <field name="qty_on_site" />
        <field name="qty_beli" readonly="1" decoration-muted="1" />
        <field name="uom_id" readonly="1"/>
        <!-- <field name="list_price" string="Harga Satuan" readonly="1"/> -->
        <!-- <field name="subtotal" string="Subtotal" readonly="1"/> -->
        <field name="rab_sale_price" string="Harga RAB" readonly="1" optional="show"/>
        <field name="rab_subtotal" string="Subtotal RAB" readonly="1" optional="show"/>
        <!-- wajib ada supaya bisa dipakai di readonly logic -->
        <field name="is_manual" column_invisible="True"/>
      </list>
    </field>
  </record>
</odoo>