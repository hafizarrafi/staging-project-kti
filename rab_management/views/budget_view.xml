<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== BUDGET MASTER ==================== -->

    <record id="view_budget_master_list" model="ir.ui.view">
        <field name="name">budget.master.list</field>
        <field name="model">budget.master</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="description"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_budget_master_form" model="ir.ui.view">
        <field name="name">budget.master.form</field>
        <field name="model">budget.master</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Keterangan..."/>
                    <notebook>
                        <page string="Estimasi Budget">
                            <field name="estimate_ids">
                                <list>
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                    <field name="amount"/>
                                    <field name="amount_actual"/>
                                    <field name="amount_remaining"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_budget_master" model="ir.actions.act_window">
        <field name="name">Master Budget</field>
        <field name="res_model">budget.master</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ==================== BUDGET ESTIMATE ==================== -->

    <record id="view_budget_estimate_list" model="ir.ui.view">
        <field name="name">budget.estimate.list</field>
        <field name="model">budget.estimate</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'confirmed'" decoration-muted="state == 'draft'">
                <field name="budget_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="amount"/>
                <field name="amount_actual"/>
                <field name="amount_remaining"/>
                <field name="state"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_budget_estimate_form" model="ir.ui.view">
        <field name="name">budget.estimate.form</field>
        <field name="model">budget.estimate</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm"
                            string="Konfirmasi"
                            type="object"
                            class="btn-primary"
                            invisible="state == 'confirmed'"/>
                    <button name="action_reset_draft"
                            string="Reset ke Draft"
                            type="object"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="budget_id"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="amount"/>
                            <field name="amount_actual"/>
                            <field name="amount_remaining"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Keterangan..."/>
                    <notebook>
                        <page string="Transaksi">
                            <field name="transaction_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="move_id"/>
                                    <field name="amount"/>
                                    <field name="note"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_budget_estimate" model="ir.actions.act_window">
        <field name="name">Budget Estimate</field>
        <field name="res_model">budget.estimate</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ==================== BUDGET TRANSACTION ==================== -->

    <record id="view_budget_transaction_list" model="ir.ui.view">
        <field name="name">budget.transaction.list</field>
        <field name="model">budget.transaction</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="budget_estimate_id"/>
                <field name="move_id"/>
                <field name="amount"/>
                <field name="note"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_budget_transaction_form" model="ir.ui.view">
        <field name="name">budget.transaction.form</field>
        <field name="model">budget.transaction</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="budget_estimate_id"/>
                            <field name="move_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="amount"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Keterangan..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_budget_transaction" model="ir.actions.act_window">
        <field name="name">Budget Transaction</field>
        <field name="res_model">budget.transaction</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ==================== ACCOUNT MOVE (Journal Entry) INHERIT ==================== -->

    <record id="view_move_form_inherit_budget" model="ir.ui.view">
        <field name="name">account.move.form.budget</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Button in header: visible when posted, master budget selected, not yet transacted -->
            <xpath expr="//header/field[@name='state']" position="before">
                <button name="action_add_to_budget"
                        string="Tambah ke Budget"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'posted' or not budget_master_id or budget_transaction_id"/>
            </xpath>

            <!-- Budget fields: new page in notebook -->
            <xpath expr="//page[@id='other_tab_entry']" position="after">
                <page string="Budget" name="budget_tab">
                    <group>
                        <group>
                            <field name="budget_master_id"
                                   readonly="budget_transaction_id != False"/>
                        </group>
                        <group>
                            <field name="budget_transaction_id" readonly="1"
                                   invisible="not budget_transaction_id"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- ==================== MENU ==================== -->

    <!-- Parent: "Budget" sejajar dengan "Vendors" di bawah root Accounting (enterprise: accountant) -->
    <menuitem id="menu_budget_root"
              name="Budget"
              parent="accountant.menu_accounting"
              sequence="4"
              groups="account.group_account_manager"/>

    <menuitem id="menu_budget_master"
              name="Master Budget"
              parent="menu_budget_root"
              action="action_budget_master"
              sequence="10"
              groups="account.group_account_manager"/>

    <menuitem id="menu_budget_estimate"
              name="Budget Estimate"
              parent="menu_budget_root"
              action="action_budget_estimate"
              sequence="20"
              groups="account.group_account_manager"/>

    <menuitem id="menu_budget_transaction"
              name="Budget Transaction"
              parent="menu_budget_root"
              action="action_budget_transaction"
              sequence="30"
              groups="account.group_account_manager"/>

</odoo>
