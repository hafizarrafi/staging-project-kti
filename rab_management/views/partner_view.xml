<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Partner Form View to add Contact Type field -->
    <record id="view_partner_form_contact_type" model="ir.ui.view">
        <field name="name">res.partner.form.contact.type</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- Add contact_type field in Sales & Purchase tab under Misc section -->
            <xpath expr="//page[@name='sales_purchases']//group[@name='misc']" position="inside">
                <field name="contact_type"/>
            </xpath>
        </field>
    </record>
</odoo>