            <!-- HEADER + BACK BUTTON -->
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h2 class="mb-0">RAB Vendor Comparison</h2>

                <button class="btn btn-sm btn-outline-secondary" t-on-click="closeAndBack"> 
